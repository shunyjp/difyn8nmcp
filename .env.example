# ──────────────────────────────────────────────
# MCP サーバー 環境変数テンプレート
# このファイルをコピーして .env を作成し、実際の値を入力してください
# .env は .gitignore に追加して GitHub に Push しないこと
# ──────────────────────────────────────────────

# n8n 接続情報
N8N_BASE_URL=http://ysjpn8n.zeabur.app
N8N_API_KEY=your_n8n_api_key_here

# Dify 接続情報
DIFY_BASE_URL=https://ysdify.zeabur.app
DIFY_EMAIL=your_dify_email@example.com
DIFY_PASSWORD=your_dify_password_here
